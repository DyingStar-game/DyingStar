<Project Sdk="Godot.NET.Sdk/4.7.0">
  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <!-- Copy the NuGet dependencies next to DyingStar.dll on every build, not only on export: without
         them the OpenTelemetry bridge throws FileNotFoundException on every print() in the editor, in
         GUT and in headless probes. -->
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <!-- No ICU: .NET otherwise loads the system's libicu at start and aborts the game where there is
         none (NixOS through appimage-run, minimal distributions; 2026-10-25). The C# code formats and
         compares nothing by culture, and Godot does the game's translations. -->
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>
 <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging" Version="9.0.8" />
    <PackageReference Include="Microsoft.Extensions.Logging.Console" Version="9.0.8" />
    <PackageReference Include="OpenTelemetry" Version="1.12.0" />
    <PackageReference Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.12.0" />
  </ItemGroup>
</Project>
