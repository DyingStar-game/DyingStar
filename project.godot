[internationalization]

locale/translation_remaps={
"res://assets/textures/Localizations/uk_flag.jpg": PackedStringArray("res://assets/textures/Localizations/es_flag.jpg:es", "res://assets/textures/Localizations/fr_flag.jpg:fr")
}
locale/translations=PackedStringArray("res://tools/localization/localisation.en.translation", "res://tools/localization/localisation.es.translation", "res://tools/localization/localisation.fr.translation")

[layer_names]

3d_render/layer_1="local"
3d_render/layer_20="celestial"
3d_physics/layer_1="world"
3d_physics/layer_2="player"
3d_physics/layer_3="vehicle"
3d_physics/layer_4="prop"
3d_physics/layer_5="zone"
3d_physics/layer_6="interactable"

[navigation]

pathfinding/max_threads=-1
3d/merge_rasterizer_cell_scale=0.25

[physics]

3d/run_on_separate_thread=true
3d/physics_engine="Jolt Physics"
jolt_physics_3d/limits/max_body_pairs=131072
3d/default_gravity=0.0

[rendering]

renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/anisotropic_filtering_level=4
viewport/hdr_2d=true
environment/defaults/default_clear_color=Color(0.310617, 0.310617, 0.310617, 1)
occlusion_culling/use_occlusion_culling=true
