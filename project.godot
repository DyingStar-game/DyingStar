; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="DyingStar"
config/version="0.0.1-dev"
run/main_scene="uid://dpderfrunb8lr"
run/main_loop_type="SceneTreeExtended"
config/features=PackedStringArray("4.7", "C#", "Double Precision", "GL Compatibility")
boot_splash/image="uid://ck5w0cxx7uj4"
config/icon="uid://bqoexxd6necib"
boot_splash/minimum_display_time=1000

[audio]

buses/default_bus_layout="uid://cd7poak5pgtx6"
driver/enable_input=true

[autoload]

SettingsManager="*res://scenes/globals/settings_manager.gd"
Globals="*res://scenes/globals/globals.gd"
GameOrchestrator="*res://scenes/globals/game_orchestrator.gd"
NetworkOrchestrator="*res://scenes/globals/network_orchestrator.gd"
ChatNetwork="*res://scenes/globals/chat_network.gd"
uuid="*res://addons/uuid/uuid.gd"
Endtoend="*res://scenes/globals/endtoend.gd"
ServerNetwork="*res://server/server_network.gd"
Obs="*res://tools/observability/obs.gd"
GameRecorder="*res://scenes/globals/game_recorder.gd"

[debug]

file_logging/enable_file_logging=true
gdscript/warnings/native_method_override=1
ErrorManager="*res://ui/error_message/error_message.tscn"
PersistanceManager="*res://server/persistance_manager/PersistanceManager.cs"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/hdr/request_hdr_output=true
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[dotnet]

project/assembly_name="DyingStar"

[editor]

import/use_multiple_threads=false

[editor_plugins]

enabled=PackedStringArray("res://addons/dyingstar/plugin.cfg", "res://addons/extremely_fast_atmosphere/plugin.cfg", "res://addons/godot-livekit/plugin.cfg", "res://addons/gut/plugin.cfg", "res://addons/open-world-database/plugin.cfg", "res://addons/planet_tools/plugin.cfg", "res://addons/uuid/plugin.cfg")

[file_customization]

folder_colors={
"res://assets/": "green",
"res://assets_blender/": "orange",
"res://levels/": "purple",
"res://scenes/": "blue"
}

[filesystem]

import/blender/enabled=false

[global_group]

gravity=""
containable=""
player=""
spawn="spawn area (apartments)"
teleporter=""
navigation_mesh=""

