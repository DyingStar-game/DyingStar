extends GutTest
## The glory and the iridescence of the dust sea (DustSeaMie, generated by tools/weather/mie_glory_table.py from
## the Mie theory of corundum grains): coloured near the sun and around the antisolar point, white between,
## brightness kept (the colour only), and the shader's copy of the lookup (dust_sea.gdshaderinc sea_mie_tint)
## reads the same tables.

const LUMINANCE := Vector3(0.2126, 0.7152, 0.0722)


func _at(angle_deg: float, strength: float = 1.0) -> Vector3:
	return DustSeaMie.tint(cos(deg_to_rad(angle_deg)), strength, strength)


func test_white_between_the_lobes() -> void:
	assert_eq(_at(90.0), Vector3.ONE, "side light: no colour")
	assert_eq(_at(45.0), Vector3.ONE)
	assert_eq(_at(135.0), Vector3.ONE)


func test_the_glory_is_coloured_around_the_shadow() -> void:
	var centre := _at(179.8)
	assert_gt(centre.z, centre.x, "the centre of the glory leans blue")
	var ring := _at(180.0 - 11.0)
	assert_gt(ring.x, ring.z, "its ring, ~11 deg out, leans red-orange")


func test_the_iridescence_near_the_sun() -> void:
	var near := _at(1.0)
	var far := _at(16.0)
	assert_gt(near.z, near.x, "bluish right by the sun")
	assert_gt(far.x, far.z, "orange further out")


func test_the_colour_keeps_the_brightness() -> void:
	for angle: float in [0.5, 8.0, 15.0, 165.0, 172.0, 179.5]:
		assert_almost_eq(_at(angle).dot(LUMINANCE), 1.0, 0.02, "luminance 1 at %s deg" % angle)


func test_strength_zero_is_white_and_the_lobes_fade_out() -> void:
	assert_eq(_at(179.0, 0.0), Vector3.ONE, "strength 0: no colour")
	var half_fore := DustSeaMie.tint(cos(deg_to_rad(1.0)), 0.5, 1.0)
	assert_almost_eq(half_fore.x, lerpf(1.0, _at(1.0).x, 0.5), 1e-6, "each lobe its own strength")
	assert_eq(DustSeaMie.tint(cos(deg_to_rad(179.0)), 0.0, 1.0), _at(179.0), "the glory keeps its own")
	assert_almost_eq(_at(DustSeaMie.FORE_DEG - 0.01).distance_to(Vector3.ONE), 0.0, 0.01, "no seam at the lobe's end")


func test_the_shader_reads_the_generated_tables() -> void:
	var shader: String = FileAccess.get_file_as_string("res://scenes/_universe/environment/dust_sea_mie.gdshaderinc")
	assert_string_contains(shader, "const vec3 SEA_MIE_BACK[%d]" % DustSeaMie.SAMPLES)
	var first: Vector3 = DustSeaMie.BACK[0]
	assert_string_contains(shader, "vec3(%.4f, %.4f, %.4f)" % [first.x, first.y, first.z],
			"the shader's tables and the script's come from the same run")
	var aerial: String = FileAccess.get_file_as_string("res://scenes/_universe/environment/aerial_perspective.gdshader")
	assert_lt(aerial.find("dust_sea_mie.gdshaderinc"), aerial.find("dust_sea.gdshaderinc\""),
			"the tables are included before the sea that reads them")
