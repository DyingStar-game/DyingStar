[sub_resource type="Shader" id="Shader_uow4d"]
code = "shader_type fog;

uniform sampler2D noise_tex : repeat_enable;
uniform float noise_scale : hint_range(0.0, 1.0, 0.0001) = 0.05;
uniform float flatness : hint_range(0.0, 50.0, 0.1) = 15.0;
uniform float density : hint_range(0.0, 6.0, 0.0001) = 2.0;
uniform sampler2D grad_tex;
uniform vec3 emission : source_color = vec3(0.8, 0.6, 0.3); // sandy color
uniform float fog_speed : hint_range(-5.0, 5.0, 0.001) = 1.5;

void fog() {
    vec2 move_uv = vec2(0.1, 0.1) * TIME * fog_speed;

    // Two layers of noise for detail
    float detail_noise = texture(noise_tex, WORLD_POSITION.xz * noise_scale + move_uv * 0.5).r;
    float noise = texture(noise_tex, WORLD_POSITION.xz * noise_scale + move_uv + detail_noise).r;

    // Apply vertical flatness (keeps storm close to the ground)
    DENSITY = mix(1.0, noise, UVW.y * flatness);
    DENSITY *= step(0.0, -SDF) * density;

    // Color from gradient
    vec3 col = texture(grad_tex, vec2(DENSITY, 0.5)).rgb;
    ALBEDO = col;
    EMISSION = emission;
}

"

