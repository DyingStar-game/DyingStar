class_name HairHead
extends Resource

## The neutral head as hair grows on it (HairGroom): the scalp, and the space around the head that strands
## stay out of. Generated by tools/character/hair_groom/hair_head.py, packed by pack_hair_head.tscn: never
## edit by hand. Read-only once loaded: safe from the bake workers.

const PATH: String = "res://assets/_universe/characters/human/hair_head.res"

## The skull's centre (m, neutral head): heights on the skull and the hairline are taken from it.
@export var centre: Vector3
## The hair's whorl at the back of the top (m): a crown parts away from it, and thins first there.
@export var crown: Vector3
## Compact head vertices of the scalp (bank indices).
@export var scalp_vertex: PackedInt32Array
## Per scalp vertex: its position on the neutral head (m).
@export var scalp_position: PackedVector3Array
## Per scalp vertex: its normal.
@export var scalp_normal: PackedVector3Array
## Per scalp vertex: how much hair grows there, 0..1 (the hairline fades in; the ears stay bare).
@export var scalp_density: PackedFloat32Array
## Per scalp vertex: how far above the hairline it is (sine of the elevation seen from the centre): a
## receding hairline raises that line.
@export var scalp_above: PackedFloat32Array
## Per scalp vertex: how far it is from the scalp's edge (m). The hairline fades in across this, whichever
## way the line runs (down the temples, the elevation changes along it, not across it).
@export var scalp_edge: PackedFloat32Array
## Triangles over the scalp vertices (positions in scalp_vertex), where hair roots are drawn.
@export var scalp_triangles: PackedInt32Array
## The scalp at render level (split at UV seams), for a shell of hair lifted off it: per render vertex,
## its scalp vertex (position in scalp_vertex).
@export var shell_vertex: PackedInt32Array
## Per shell render vertex: its UV on the face's maps.
@export var shell_uv: PackedVector2Array
## Triangles over the shell's render vertices.
@export var shell_index: PackedInt32Array
## Per shell render vertex: reference tangent (x, y, z, handedness).
@export var shell_tangent: PackedFloat32Array
## Corner of the signed distance grid (m).
@export var sdf_origin: Vector3
## Side of a grid cell (m).
@export var sdf_cell: float = 0.008
## Grid points along x, y, z.
@export var sdf_size: Vector3i
## Signed distance (m, > 0 outside) to the head, neck and shoulders at each grid point, x fastest.
@export var sdf: PackedFloat32Array
## Compact head vertices where a beard may grow (groom.beard_zones).
@export var beard_vertex: PackedInt32Array
## Per beard vertex: its position on the neutral head (m).
@export var beard_position: PackedVector3Array
## Per beard vertex: its normal.
@export var beard_normal: PackedVector3Array
## Per beard vertex, 4 values 0..1: how much it is in each zone (BeardCut.ZONES: moustache, chin, cheeks,
## neck).
@export var beard_zones: PackedFloat32Array
## Triangles over the beard vertices (positions in beard_vertex).
@export var beard_triangles: PackedInt32Array
## The beard's skin at render level, for its shell: per render vertex its beard vertex (position in
## beard_vertex).
@export var beard_shell_vertex: PackedInt32Array
## Per beard shell render vertex: its UV.
@export var beard_shell_uv: PackedVector2Array
## Triangles over the beard shell's render vertices.
@export var beard_shell_index: PackedInt32Array
## Per beard shell render vertex: reference tangent (x, y, z, handedness).
@export var beard_shell_tangent: PackedFloat32Array
## The Head bone (HumanBank.bone_names index) hair is hung on.
@export var head_bone: int = 0

static var _shared: HairHead = null
static var _mutex := Mutex.new()


## The game's head data (loaded on first use, any thread).
static func shared() -> HairHead:
	_mutex.lock()
	if _shared == null:
		_shared = load(PATH) as HairHead
	var out: HairHead = _shared
	_mutex.unlock()
	return out


## [signed distance (m), outward normal] at [param p]: trilinear in the grid, the normal its gradient.
## Outside the grid: far, and away from the centre.
func surface(p: Vector3) -> Array:
	var g: Vector3 = (p - sdf_origin) / sdf_cell
	var x0: int = floori(g.x)
	var y0: int = floori(g.y)
	var z0: int = floori(g.z)
	if x0 < 0 or y0 < 0 or z0 < 0 or x0 >= sdf_size.x - 1 or y0 >= sdf_size.y - 1 or z0 >= sdf_size.z - 1:
		return [1.0, (p - centre).normalized()]
	var fx: float = g.x - x0
	var fy: float = g.y - y0
	var fz: float = g.z - z0
	var sx: int = 1
	var sy: int = sdf_size.x
	var sz: int = sdf_size.x * sdf_size.y
	var i: int = x0 + y0 * sy + z0 * sz
	var c000: float = sdf[i]
	var c100: float = sdf[i + sx]
	var c010: float = sdf[i + sy]
	var c110: float = sdf[i + sx + sy]
	var c001: float = sdf[i + sz]
	var c101: float = sdf[i + sx + sz]
	var c011: float = sdf[i + sy + sz]
	var c111: float = sdf[i + sx + sy + sz]
	var c00: float = lerpf(c000, c100, fx)
	var c10: float = lerpf(c010, c110, fx)
	var c01: float = lerpf(c001, c101, fx)
	var c11: float = lerpf(c011, c111, fx)
	var c0: float = lerpf(c00, c10, fy)
	var c1: float = lerpf(c01, c11, fy)
	var d: float = lerpf(c0, c1, fz)
	var dx: float = lerpf(lerpf(c100 - c000, c110 - c010, fy), lerpf(c101 - c001, c111 - c011, fy), fz)
	var dy: float = lerpf(c10 - c00, c11 - c01, fz)
	var dz: float = c1 - c0
	var grad := Vector3(dx, dy, dz)
	return [d, grad.normalized() if grad.length_squared() > 1e-12 else (p - centre).normalized()]
