class_name HumanAssetData
extends Resource

## One mesh worn on the body (a part of a hair style, of eyebrows, the eyelashes, or one piece of an
## outfit), with what the runtime needs to fit it on any body shape. Generated by tools/character
## (vitruvian/refit_outfits.py, hair_groom/groom.py; packed by human_bank/pack_human_bank.tscn): never
## edit by hand.
##
## Fitting (MakeHuman's MHCLO rule): each asset vertex is the weighted sum of 3 body vertices plus an
## offset scaled by how much the body grew along each axis (the distance between two reference vertices
## over its original length).

## Asset kind: hair, eyebrows, eyelashes, eyes, teeth, tongue or outfit.
@export var kind: StringName
## Position of the choice in its kind's list (assets.json); what an appearance stores.
@export var slot: int = 0
## Piece number inside a multi-mesh choice (an outfit is a suit plus shoes).
@export var part: int = 0
## Stable name of the choice (assets.json id), e.g. "short02" or "male_casual01".
@export var id: StringName
## Body the asset suits: male, female or any.
@export var gender: StringName
## Per asset vertex, 3 compact body vertex indices (flattened).
@export var refs: PackedInt32Array
## Per asset vertex, the 3 barycentric weights matching refs (flattened).
@export var weights: PackedFloat32Array
## Per asset vertex, the offset (m) added after the barycentric point, scaled per axis.
@export var offsets: PackedVector3Array
## For X, Y, Z: two compact body vertices whose distance measures the body's size on that axis (-1 = none).
@export var scale_pairs: PackedInt32Array
## Reference distance (m) of each scale pair on the original basemesh.
@export var scale_ref: PackedFloat32Array
## Per render vertex: the asset vertex it copies (render vertices are split at UV seams).
@export var vertex: PackedInt32Array
## Per render vertex: its UV.
@export var uv: PackedVector2Array
## Triangle list over the render vertices.
@export var index: PackedInt32Array
## Per render vertex: reference tangent (x, y, z, handedness), re-orthogonalised at runtime.
@export var tangent: PackedFloat32Array
## Per render vertex: 4 skin bone indices into HumanBank.bone_names.
@export var bones: PackedByteArray
## Per render vertex: the 4 skin weights matching bones.
@export var bone_weights: PackedFloat32Array
## Per render vertex: a colour the asset's shader reads (hair: how far along the strand, a random value,
## the layer, the density at the root -- tools/character/hair_groom). Empty for most assets.
@export var color: PackedColorArray
## Per render vertex: the normal it is lit with, kept as it is (ribbons of hair are lit as the volume they
## make, not each as its own flat strip). Empty = made from the mesh at bake time.
@export var normal_fixed: PackedVector3Array
## Style "strands" (a head of hair): the guide strands, strand after strand, strand_size points each, in
## the neutral head's space. The asset's refs / weights / offsets then bind the guides' ROOTS only: the
## game makes the hairs around the guides once per style (HairStrands) and fits them to a head by where
## its roots land. `color` is per guide: R = 1 when the length slider may cut it, G = a random value, B =
## its layer, A = the hair's density at its root.
@export var strand_points: PackedVector3Array
## Points per guide strand of strand_points.
@export var strand_size: int = 0
## Per guide strand: how far from its root it starts to move (HairMotion), m -- or a code: below 0, that many
## times the shaders' fixed_length (a loose cut's hairs); HairMotionBinding.RIGID or more, never (the scalp's hairs
## of a tied cut, gathered to their tie). Empty: the whole style is rigid.
@export var strand_free: PackedFloat32Array
## How hairs are made around a guide: children (hairs per guide), clump (m: how far from the guide a
## hair's root may be), clump_tip (share of that left at the tip), frizz (m: how far a hair strays),
## longest (m: the style's longest strand, what the length slider cuts against), centre (the skull's).
@export var strand_params: Dictionary
## Its own levels of detail, as pairs (error in m, share of `index` kept): a level draws the first share
## of the triangles, and shows once its error is under a pixel. For meshes the engine's simplifier cannot
## reduce (loose ribbons of hair, shell layers); empty = the engine makes them.
@export var lods: PackedFloat32Array
## How the asset is drawn when its kind does not say: "cards" (ribbons of hair) or "shell" (hair seen
## end-on, in layers over the skin); empty for the others.
@export var style: StringName
## Compact body vertices hidden under this asset (their triangles are dropped from the body).
@export var delete: PackedInt32Array
## Colour texture (alpha = coverage for hair, brows and lashes).
@export var albedo: Texture2D
## Tangent-space normal map, or null.
@export var normal: Texture2D
## Ambient occlusion map, or null.
@export var ao: Texture2D
