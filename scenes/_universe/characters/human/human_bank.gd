class_name HumanBank
extends Resource

## Everything needed to bake a body from creator sliders at runtime: the base mesh, every target the
## sliders can reach, the joints of the game skeleton, the body's render mesh and skin weights, and the
## wearable assets. Generated by tools/character/vitruvian (export_vitruvian.py in Blender,
## build_vitruvian_bank.py, then tools/character/human_bank/pack_human_bank.tscn) from the Vitruvian
## Project human (CC0): never edit by hand, regenerate it.
##
## Vertices live in a COMPACT space -- only the basemesh vertices the game uses -- in metres, in Godot's
## frame (Y up, the body facing +Z), with MakeHuman's origin (the soles are NOT at y = 0: the builder
## re-grounds the body).
##
## A target is int16-quantised: delta = int16 * target_scale. It is either sparse (target_count entries
## of sparse_index, starting at target_sparse_start) or dense (one delta per compact vertex). Its deltas
## start at target_delta_start (in int16 units, 3 per vertex) in `delta`.

const PATH: String = "res://assets/_universe/characters/human/human_bank.res"

## Rest positions of the compact vertices (m).
@export var base: PackedVector3Array
## Original basemesh index of each compact vertex (for debugging and MakeHuman cross-checks).
@export var keep: PackedInt32Array
## Target keys: macro combinations ("macrodetails/universal-male-young-...") and slider targets ("nose-trans-up").
@export var target_names: PackedStringArray
## Per target: metres per int16 unit.
@export var target_scale: PackedFloat32Array
## Per target: first int16 of its deltas in `delta`.
@export var target_delta_start: PackedInt32Array
## Per target: number of vertices it moves (all compact vertices when dense).
@export var target_count: PackedInt32Array
## Per target: 1 when stored dense (no index list), 0 when sparse.
@export var target_dense: PackedByteArray
## Per sparse target: first entry of its vertex list in sparse_index (-1 when dense).
@export var target_sparse_start: PackedInt32Array
## Vertex lists of the sparse targets, uint16 little-endian.
@export var sparse_index: PackedByteArray
## All target deltas, int16 little-endian, x y z per vertex.
@export var delta: PackedByteArray
## MakeHuman's macrodetails/macro.json: how each macro slider splits into the levels the targets are named after.
@export var macro_config: Dictionary
## The 52 ARKit face units, as target keys ("faceunits/jawOpen"...), ARKit's alphabetical order: the
## face mesh's blend shapes (HumanBuilder, face_units orders).
@export var face_units: PackedStringArray
## Per compact vertex, where each beard style grows, 0..255: full beard, moustache, goatee, (unused).
## Drawn on the body by the skin shader (vertex colour).
@export var beard_mask: PackedByteArray
## The creator's shape sliders (tools/character/human_bank/catalogue.json, append-only: position = id).
@export var catalogue: Array
## The creator's asset choices per kind (tools/character/human_bank/assets.json, append-only).
@export var asset_catalogue: Dictionary
## Skeleton bone names, in the order the joint and skin data use (Godot humanoid profile names).
@export var bone_names: PackedStringArray
## Parent of each bone ("" for the root).
@export var bone_parents: PackedStringArray
## Per bone, 2 runs (head, tail) of joint_index: run k spans joint_ptr[k] .. joint_ptr[k + 1].
@export var joint_ptr: PackedInt32Array
## Compact vertices whose mean gives each joint (MakeHuman's joint cubes).
@export var joint_index: PackedInt32Array
## Per joint_index entry, its weight in the joint (an affine combination: the weights of a run sum to 1).
## Empty = a plain mean (MakeHuman's joint cubes).
@export var joint_weight: PackedFloat32Array
## Per bone, the bone it points at in the body's own rest pose (-1: none, it turns with its parent). The
## body rests in an A pose, the game skeleton in a T pose: HumanBuilder turns each bone from the first to
## the second in the skin binds.
@export var bone_aim: PackedInt32Array
## Compact vertices of the soles: the lowest one, once the body is in the skeleton's pose, stands at y = 0.
@export var sole_vertex: PackedInt32Array
## Material zones of the body ("Face", "Torso", "Arms", "Legs", "Iris", "Mouth"...): each has its textures.
@export var zone_names: PackedStringArray
## Per zone, its range of render vertices: zone z spans zone_vertex_ptr[z] .. zone_vertex_ptr[z + 1].
@export var zone_vertex_ptr: PackedInt32Array
## Per zone, its range of body_index; its triangles index the zone's OWN vertex range from 0.
@export var zone_index_ptr: PackedInt32Array
## Body render vertices: the compact vertex each one copies (split at UV seams).
@export var body_vertex: PackedInt32Array
## Body render vertex UVs (MakeHuman skin layout).
@export var body_uv: PackedVector2Array
## Body triangles over the render vertices.
@export var body_index: PackedInt32Array
## Body render vertex reference tangents (x, y, z, handedness).
@export var body_tangent: PackedFloat32Array
## Per compact vertex: 4 skin bone indices into bone_names.
@export var skin_bones: PackedByteArray
## Per compact vertex: the 4 skin weights matching skin_bones.
@export var skin_weights: PackedFloat32Array
## Wearable assets (HumanAssetData), all kinds.
@export var assets: Array[HumanAssetData] = []


## The assets of one choice (several meshes for an outfit), in part order.
func assets_of(kind: StringName, slot: int) -> Array[HumanAssetData]:
	var out: Array[HumanAssetData] = []
	for a in assets:
		if a.kind == kind and a.slot == slot:
			out.append(a)
	out.sort_custom(func(x: HumanAssetData, y: HumanAssetData) -> bool: return x.part < y.part)
	return out


## Index of a target key, or -1.
func target_index(key: String) -> int:
	return target_names.find(key)
