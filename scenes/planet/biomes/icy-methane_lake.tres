[resource]
script = ExtResource("1")
biome_type = "icy-methane_lake"
biome_index = 47
display_name = "Methane Lake"
description = "A liquid basin composed of a mixture of light hydrocarbons, primarily methane and ethane. Stable under cryogenic pressure and temperature conditions. The liquid has very low viscosity and surface tension, resulting in extremely slow and faint waves. Shorelines are sculpted by the erosion of hydrocarbons on a base of rock-hard water ice."
category = "cryo"
color = Color(0.165, 0.29, 0.416, 1)
terrain_material_override = ExtResource("2")
is_liquid = true
elevation_min = -500.0
elevation_max = 500.0
terrain_roughness = 0.1
wind_strength = 0.3
movement_speed_factor = 0.25
damage_per_second = 1.5
vehicle_traversable = false
