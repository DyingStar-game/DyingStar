<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <!--
      Use the double-precision GodotSharp / Godot.NET.Sdk packages bundled with
      the custom Godot build (under GodotSharp/Tools/nupkgs/). The official
      packages on nuget.org are single-precision and crash at runtime when paired
      with a double-precision Godot binary (Vector3/Transform3D layout mismatch).
      Set GODOT_SHARP_NUPKGS to the absolute path of that directory before
      restoring/exporting, e.g.:
          export GODOT_SHARP_NUPKGS=/path/to/Godot_v4.6.1-stable_mono_linux_x86_64/GodotSharp/Tools/nupkgs
    -->
    <clear />
    <add key="godot-double-precision" value="%GODOT_SHARP_NUPKGS%" />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
  <packageSourceMapping>
    <!-- Force GodotSharp / Godot.NET.Sdk to come from the local source. -->
    <packageSource key="godot-double-precision">
      <package pattern="Godot.*" />
      <package pattern="GodotSharp*" />
    </packageSource>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
