# Optional configuration for tools/planettech/qgis/export_planet.py.
# Copy to `export_config.ini` (same directory) and adjust as needed.
# Values here are overridden by environment variables when both are set.

[godot]
# Absolute path to the Godot binary used for recipe JSON→binary conversion
# and .planetpack packing. Must be a double-precision mono build (see
# .github/copilot-instructions.md for the canonical path).
#
# Resolution order used by export_planet.py:
#   1. $GODOT_BIN
#   2. [godot] path in this file
#   3. `godot` on PATH
#   4. Hard-coded canonical fallback in export_planet.py
#
# path = /datas/developpement/sources/godotengine/godot-build-scripts/releases/4.6.1-stable/mono/Godot_v4.6.1-stable_mono_linux_x86_64/Godot_v4.6.1-stable_mono_linux.x86_64

[paths]
# Where export_cave_sites.py writes <planet>_cave_sites.json (private, outside the repository).
# Default: ~/dyingstar-private/caves
# cave_export_dir = ~/dyingstar-private/caves

[publish]
# Publish every export straight onto the tile service (nginx), over SSH — the game reads
# nothing local, so an export is only seen once published. With `ssh` set, the exporters
# (link_modifiers.link, export_elevation.py) and tools/bake_grade_profiles.gd publish on their
# own, in the background (log: <planet>_chunks/publish.log). Each key can be overridden by
# $DS_PUBLISH_<KEY>. Check the target first:
#     python3 tools/planettech/publish/publish_remote.py --check
# See tools/planettech/publish/publish_remote.py.
#
# ssh     = deploy@planettech.dyingstar-game.space
# port    = 22
# dist    = /var/www/dist
# workdir = ds-publish
# python  = python3
# channel = unstable
# http    = https://planettech.dyingstar-game.space
